# =============================================================================
# spark-project-status — Configuration
# =============================================================================
#
# This file documents all available configuration parameters.
# Copy this file to .env and fill in your values.
#
# Parameters can also be supplied via environment variables or CLI flags.
# Run `spark-project-status --help` for the full list of CLI options.
#
# Priority order (highest to lowest): CLI flags > env vars > .env file
# =============================================================================

# ---------------------------------------------------------------------------
# NextCloud
# ---------------------------------------------------------------------------

# Full URL of your NextCloud instance (no trailing slash)
NC_URL="https://nextcloud.example.com"

# App-user token for API authentication (create one in NextCloud user settings)
NC_APP_USER=""

# App-password/token (never share this)
NC_APP_PWD=""

# NextCloud Deck board ID to query
NCDECK_BOARD_ID=1

# ---------------------------------------------------------------------------
# LLM / Spark API
# ---------------------------------------------------------------------------

# Base URL of the Spark / OpenAI-compatible API endpoint
SPARK_URL="http://127.0.0.1:8214"

# API key for the LLM server (sent as Authorization Bearer header)
# Optional — omit if the server doesn't require authentication
SPARK_API_KEY=""

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------

# Display name of the project (used in report filenames)
PROJECT_NAME="My Project"

# Parent folder path inside NextCloud where project files live
PROJECT_FILES_PARENT_PATH="Personal"

# =============================================================================
# Schedule — run reports continuously or on a timer
# =============================================================================
# Values: "once", "interval::<duration>", or "daily::<HH:MM>"
# Examples:
#   once              — run once and exit (default)
#   interval::1h      — run every hour
#   interval::30m     — run every 30 minutes
#   daily             — run once per day at midnight
#   daily::06:00      — run once per day at 6:00 AM
#SPARK_SCHEDULE="once"

# Active scheduling window — only run reports inside this time window
# Format: HH:MM-HH:MM (e.g. 08:00-19:00)
# Overnight windows also work: 22:00-06:00
# Leave commented (or empty) to always be active
#SCHEDULE_WINDOW="08:00-19:00"

# ---------------------------------------------------------------------------
# Report Formatting
# ---------------------------------------------------------------------------
# Set to any value to skip prepending the web-theme to reports.
# The web-theme file is still fetched and uploaded, just not included in the
# report content. Useful for plain-text or non-web output.
#NO_WEB_THEME=""

# ---------------------------------------------------------------------------
# Output Control
# ---------------------------------------------------------------------------
# Set to any value to save the report locally only — skip WebDAV upload.
# Useful when you want local copies without cloud storage.
#SAVE_ONLY=""

# Report filename — defaults to '<timestamp> Project Status.md'
# Set to a static name for a stable path you can bookmark:
#   REPORT_FILENAME="project-status.md"
# When combined with COPY_DAV, the report is uploaded under the static name
# and also copied to a timestamped name via WebDAV.
#REPORT_FILENAME=""

# Copy report to a timestamped name via WebDAV COPY (requires REPORT_FILENAME)
# Useful for having both a stable name and per-run timestamped copies:
#   REPORT_FILENAME="project-status.md"
#   COPY_DAV=""
#COPY_DAV=""

# =============================================================================
# NOTE: The following fields are hardcoded in the Rust source and do not
# need to be configured here. The tool strips these fields from Deck cards
# before sending to the LLM to reduce prompt size:
#
#   .color, .stackId, .type, .lastModified, .lastEditor
#   .attachmentCount, .order, .commentsCount, .ETag
#   .referenceData, .assignedUsers[].id, .assignedUsers[].cardId
#   .assignedUsers[].type, .assignedUsers[].participant.type, .primaryKey
#
# Required files in your project folder (<parent>/<name>):
#   - Spark-Instructions.md  (LLM system prompt)
#   - web-theme.txt          (optional — falls back to default)
# =============================================================================
