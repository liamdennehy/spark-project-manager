# spark-project-status configuration for systemd instantiation
#
# Place this file at one of:
#   /etc/spark-project-status/<instance>/.env    (preferred — system admin)
#   /usr/local/share/spark-project-status/<instance>/.env  (package-managed)
#
# The <instance> name is the service instance (e.g. "my-project").
# See: systemctl status spark-project-status@my-project

# ── NextCloud ──────────────────────────────────────────────────────
NC_URL="https://nextcloud.example.com"
NC_APP_USER="spark"
NC_APP_PWD="your-app-password-here"
NCDECK_BOARD_ID=1

# ── LLM (Spark / OpenAI-compatible) ───────────────────────────────
SPARK_URL="https://llm.example.com/v1"
SPARK_API_KEY="your-api-key-here"

# ── Project ────────────────────────────────────────────────────────
PROJECT_NAME="My Project"
PROJECT_FILES_PARENT_PATH="Projects"

# ── Optional overrides ─────────────────────────────────────────────
# WEB_THEME=true              # Prepend web-theme to report output
# SAVE_ONLY=true                 # Save locally only, skip WebDAV upload
# REPORT_FILENAME="report.md"    # Static filename (default: timestamped)
# COPY_DAV=true                  # Also copy to timestamped filename after upload
# SCHEDULE=daily:06:00           # Run daily at 06:00 (service is oneshot; use timer instead)
# SCHEDULE_WINDOW=08:00-18:00    # Only run during this time window
